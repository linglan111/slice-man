+    counterexample: "自然停顿、换人说话或叠加字幕本身不算异常",
+  },
+  {
+    ruleId: "timing.readability_concern",
+    category: "timing",
+    riskLevel: "medium",
+    description: "具体的显示时间/文本量关系导致明显阅读困难，需播放确认",
+    example: "较长一句在不足一秒内显示",
+    counterexample: "短词或歌词闪现不能直接认为错误",
+  },
+  {
+    ruleId: "timing.severe_readability",
+    category: "timing",
