{
  "name": "slice-man",
  "version": "0.1.4",
  "description": "Windows video translation and subtitle desktop application",
  "author": "Slice Man contributors",
  "private": true,
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.17.0 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-unit.cjs run",
    "test:watch": "node scripts/test-unit.cjs",
    "test:coverage": "node scripts/test-unit.cjs run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:native": "node scripts/native-smoke.cjs",
    "test:package": "node scripts/package-smoke.cjs",
    "test:installer": "node scripts/nsis-smoke.cjs",
    "test:media": "node scripts/media-smoke.cjs",
    "test:whisper": "node scripts/whisper-smoke.cjs",
    "setup:media": "node scripts/setup-media.cjs",
    "setup:resources": "node scripts/setup-resources.cjs",
    "setup:whisper-fixtures": "node scripts/setup-whisper-fixtures.cjs",
    "setup:download-fixtures": "node scripts/setup-download-fixtures.cjs",
    "format": "prettier --write src tests *.ts *.mjs scripts",
    "native:electron": "electron-builder install-app-deps",
    "native:node": "npm rebuild better-sqlite3",
    "postinstall": "electron-builder install-app-deps",
    "package": "npm run build && electron-builder --win --x64 --dir",
    "make": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "0.45.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yauzl": "3.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.3",
    "electron": "42.11.11",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "28.1.0",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3",
    "yazl": "3.3.1"
  }
}
